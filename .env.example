# Copy this file to .env and fill in real values. .env is git-ignored; this
# file is not — never put a live key in .env.example.

# Google Maps Platform API key — covers the native Maps SDK for Android (also
# set as a <meta-data> literal in android/app/src/main/AndroidManifest.xml,
# since manifest merging can't read --dart-define) AND the Routes /
# Geocoding / Places HTTP APIs RouteService calls directly.
#
# Restrict it in Google Cloud Console → Credentials via **API restrictions**
# (Maps SDK for Android, Routes API, Geocoding API, Places API (New)) and leave
# **Application restrictions = None**: an "Android apps" restriction only
# works for the native SDK and makes every plain-HTTP call (Routes /
# Geocoding / Places) fail with REQUEST_DENIED.
#
# Requires an active billing account on the Cloud project, though normal
# dev/test volume stays within the free monthly allowance.
GOOGLE_MAPS_API_KEY=AIza_your_key_here
