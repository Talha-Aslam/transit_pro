# Copy this file to .env and fill in real values. .env is git-ignored; this
# file is not — never put a live token in .env.example.

# Public token (pk.*) — safe to ship in the app bundle, but still passed via
# --dart-define rather than committed, per this project's no-hardcoded-keys rule.
# Get it from https://account.mapbox.com/ → Tokens → your Default Public Token.
MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# Secret download token (sk.*) — Downloads:Read scope only. Used ONLY by Gradle
# to pull the Android SDK from Mapbox's private maven repo. Goes in
# ~/.gradle/gradle.properties, NOT here — this line documents that it exists.
# MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here (set in ~/.gradle/gradle.properties)
